{
  "name": "backend",
  "version": "1.0.0",
  "description": "API de PokéVault",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node --env-file=.env node_modules/.bin/node-pg-migrate --tsx --migrations-dir src/infrastructure/db/migrations --migration-file-language ts",
    "migrate:up": "node --env-file=.env node_modules/.bin/node-pg-migrate up --tsx --migrations-dir src/infrastructure/db/migrations --migration-file-language ts",
    "migrate:down": "node --env-file=.env node_modules/.bin/node-pg-migrate down --tsx --migrations-dir src/infrastructure/db/migrations --migration-file-language ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:migrate": "tsx src/scripts/testMigrate.ts",
    "seed:demo": "tsx src/infrastructure/db/seedDemoData.ts",
    "seed:demo:clear": "tsx src/infrastructure/db/seedDemoData.ts --clear",
    "hash-password": "tsx src/scripts/hashPassword.ts",
    "refresh-checklist-prices": "tsx src/scripts/refreshChecklistPrices.ts",
    "backfill-owner-user": "tsx src/scripts/backfillOwnerUser.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "fastify": "^5.12.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
