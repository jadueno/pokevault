DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault
PORT=3004

# Login obligatorio (email + contraseña -> token de sesión firmado, 30 días, con el id del
# usuario dentro) — ya no es opcional, cada fila de datos pertenece a un usuario real.
#   SESSION_SECRET: una cadena aleatoria larga para firmar los tokens de sesión, p. ej.
#   `openssl rand -hex 32`. Obligatoria: el servidor no arranca sin ella. Si cambia, todas
#   las sesiones activas dejan de ser válidas.
SESSION_SECRET=

# LOGIN_USERNAME/LOGIN_PASSWORD_HASH ya NO los lee el servidor — solo los usa el script
# puntual `npm run backfill-owner-user` (una vez, tras aplicar las migraciones de usuarios)
# para crear la primera cuenta a partir de estas dos variables:
#   1. LOGIN_USERNAME: se usa como email de esa cuenta (no exige formato estricto).
#   2. LOGIN_PASSWORD_HASH: nunca la contraseña en claro — genera el hash con
#      `npm run hash-password -- "tu-contraseña"` y pega aquí el resultado.
LOGIN_USERNAME=
LOGIN_PASSWORD_HASH=

# Base de datos separada para los tests de integración (nunca la real): créala con
# `createdb` o `psql -c "CREATE DATABASE pokevault_test"` y aplícale las
# migraciones con TEST_DATABASE_URL=... npm run migrate:up.
TEST_DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault_test
