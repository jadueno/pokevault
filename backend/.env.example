DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault
PORT=3004

# Login opcional (usuario + contraseña -> token de sesión firmado, 30 días). Las tres
# variables juntas o ninguna: sin ellas, la app no pide login (uso personal local sin
# fricción); actívalas al exponer la app más allá de tu red privada.
#   1. LOGIN_USERNAME: el que quieras, en texto plano (no es secreto por sí solo).
#   2. LOGIN_PASSWORD_HASH: nunca la contraseña en claro — genera el hash con
#      `npm run hash-password -- "tu-contraseña"` y pega aquí el resultado.
#   3. SESSION_SECRET: una cadena aleatoria larga para firmar los tokens de sesión, p. ej.
#      `openssl rand -hex 32`. Si cambia, todas las sesiones activas dejan de ser válidas.
LOGIN_USERNAME=
LOGIN_PASSWORD_HASH=
SESSION_SECRET=

# Base de datos separada para los tests de integración (nunca la real): créala con
# `createdb` o `psql -c "CREATE DATABASE pokevault_test"` y aplícale las
# migraciones con TEST_DATABASE_URL=... npm run migrate:up.
TEST_DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault_test
