DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault
PORT=3004

# Opcional: si la pones, la API exige "Authorization: Bearer <valor>" en todas las
# rutas salvo /health. Déjala sin poner para el uso personal habitual por Tailscale
# (sin fricción); actívala solo si vas a exponer la API más allá de tu red privada.
# El frontend necesita el mismo valor en VITE_API_TOKEN (ver .env.example de la raíz).
API_TOKEN=

# Base de datos separada para los tests de integración (nunca la real): créala con
# `createdb` o `psql -c "CREATE DATABASE pokevault_test"` y aplícale las
# migraciones con TEST_DATABASE_URL=... npm run migrate:up.
TEST_DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault_test

# Opcional: catálogo de cartas/sets/precios vía pokemontcg.io. Sin ella, el proveedor
# real sigue funcionando (la API es gratis sin key), pero con límite de peticiones más
# bajo — con key el rate limit sube bastante. Consíguela en https://dev.pokemontcg.io/.
# Nota: el equipo de pokemontcg.io ha movido el foco a Scrydex (de pago); si esta API
# gratuita se degrada algún día, solo hay que sustituir el adaptador
# (infrastructure/catalog/pokemonTcgApiProvider.ts), el resto de la app no cambia.
POKEMON_TCG_API_KEY=
