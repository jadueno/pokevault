DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault
PORT=3004

# Opcional: si la pones, la API exige "Authorization: Bearer <valor>" en todas las
# rutas salvo /health. Déjala sin poner para el uso personal habitual por Tailscale
# (sin fricción); actívala solo si vas a exponer la API más allá de tu red privada.
# El frontend necesita el mismo valor en VITE_API_TOKEN (ver .env.example de la raíz).
API_TOKEN=

# Base de datos separada para los tests de integración (nunca la real): créala con
# `createdb` o `psql -c "CREATE DATABASE pokevault_test"` y aplícale las
# migraciones con TEST_DATABASE_URL=... npm run migrate:up.
TEST_DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault_test

# Opcional: reconocimiento de fotos (carta/caja -> nombre/expansión/rareza) vía un
# modelo de visión local en Ollama. Sin ella, el reconocimiento usa un proveedor
# simulado (para poder clonar y correr la app sin instalar nada) y siempre hay que
# rellenar los datos a mano. Con Ollama instalado y corriendo:
#   ollama pull minicpm-v
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=
# Opcional: otro modelo de visión de Ollama distinto de "minicpm-v" (el que mejor lee
# texto pequeño para su tamaño, de los habituales). Alternativas: llava, llama3.2-vision.
OLLAMA_VISION_MODEL=

# Opcional: solo la usa `npm run sync:set-checklist` (script puntual, no la app en vivo)
# para traer el listado de cartas de un set y poder ver "qué me falta". Sin ella funciona
# igual pero con un límite de peticiones más bajo — de sobra para sincronizar un set de
# vez en cuando. Se pide gratis en https://pokemontcg.io/.
POKEMON_TCG_API_KEY=
