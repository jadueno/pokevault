POSTGRES_DB=pokevault
POSTGRES_USER=pokevault
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5436

DATABASE_URL=postgres://pokevault:change-me@localhost:5436/pokevault

# Opcional: solo si has activado API_TOKEN en backend/.env (mismo valor en los dos
# sitios). Vacío por defecto = sin autenticación, uso personal habitual por Tailscale.
VITE_API_TOKEN=
